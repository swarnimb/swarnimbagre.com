# Copy to .env.local and fill in values. Never commit .env.local.
# NEXT_PUBLIC_* vars are exposed to the browser — safe by design; RLS protects data.
# Vars without NEXT_PUBLIC_ are server-only and must never reach the client.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS. Use only in Server Actions, Route Handlers, Edge Functions.
SUPABASE_SERVICE_ROLE_KEY=

# Absolute site origin used to build the magic-link `emailRedirectTo`. No trailing slash.
# Locally: http://localhost:3000 (or 3100 for the Playwright dev server).
# On Vercel: set to https://swarnimbagre.com in Production; previews fall back to
# NEXT_PUBLIC_VERCEL_URL automatically.
NEXT_PUBLIC_SITE_URL=

# Server-only. The sole email permitted to sign in to the admin panel.
# Enforces CONSTRAINT-09 (single user) as a defense-in-depth allowlist on top
# of the Supabase dashboard "Allow new users to sign up = OFF" operational
# setting. Compared case-insensitively after trim. Set this to the single admin
# email you control — the same address created in the Supabase Auth dashboard —
# in Vercel (Production + Preview) and in local `.env.local`. The real value is
# never committed to the repo. Never NEXT_PUBLIC_.
ADMIN_ALLOWED_EMAIL=

# Optional. Preview-only. Set to 1 to show the tweaks dev panel.
# Never set in production. Absence just hides the panel.
NEXT_PUBLIC_TWEAKS=

# Test fixture only — never set in Vercel. See T19.2 / scripts/seed-test-fixture.ts.
# TEST_FIXTURE_SECRET gates the /api/test/sign-in route alongside NODE_ENV='test'
# and VERCEL !== '1'. Generate a 32-byte hex string: `openssl rand -hex 32`.
TEST_FIXTURE_SECRET=
TEST_FIXTURE_EMAIL=playwright-fixture@test.swarnimbagre.com

# -----------------------------------------------------------------------------
# Edge Function env (not in this file — set in Supabase):
#   STATS_INGEST_SECRET — shared secret for the stats-ingest Edge Function.
#   Set via Supabase dashboard → Edge Functions → Manage secrets, or
#   `supabase secrets set STATS_INGEST_SECRET=...`. The Next.js app never
#   reads this; only the Edge Function does (via Deno.env.get).
#   See docs/openclaw-config.md for the full lifecycle + rotation procedure.
# -----------------------------------------------------------------------------

# Error monitoring — deferred. T32 Option B (2026-05-14).
# Pre-launch the project relies on Vercel logs + Supabase Edge Function logs
# for error visibility. Sentry is wired in later when there is real traffic to
# observe. See docs/monitoring.md for the interim playbook and the gate
# condition that flips this back to Option A.
# When activating: create a Sentry project, paste the DSN here (server) and in
# NEXT_PUBLIC_SENTRY_DSN (client), set both in Vercel Production env, and add
# `lib/sentry.ts` + the `next.config.ts` Sentry plugin per T32 Option A.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
