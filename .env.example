# Copy to .env.local and fill in values. Never commit .env.local.
# NEXT_PUBLIC_* vars are exposed to the browser — safe by design; RLS protects data.
# Vars without NEXT_PUBLIC_ are server-only and must never reach the client.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS. Use only in Server Actions, Route Handlers, Edge Functions.
SUPABASE_SERVICE_ROLE_KEY=

# Absolute site origin used to build the magic-link `emailRedirectTo`. No trailing slash.
# Locally: http://localhost:3000 (or 3100 for the Playwright dev server).
# On Vercel: set to https://swarnimbagre.com in Production; previews fall back to
# NEXT_PUBLIC_VERCEL_URL automatically.
NEXT_PUBLIC_SITE_URL=

# Server-only. The sole email permitted to sign in to the admin panel.
# Enforces CONSTRAINT-09 (single user) as a defense-in-depth allowlist on top
# of the Supabase dashboard "Allow new users to sign up = OFF" operational
# setting. Compared case-insensitively after trim. Set to swarnim.build@gmail.com
# in Vercel (Production + Preview) and in local `.env.local`. Never NEXT_PUBLIC_.
ADMIN_ALLOWED_EMAIL=

# Test fixture only — never set in Vercel. See T19.2 / scripts/seed-test-fixture.ts.
# TEST_FIXTURE_SECRET gates the /api/test/sign-in route alongside NODE_ENV='test'
# and VERCEL !== '1'. Generate a 32-byte hex string: `openssl rand -hex 32`.
TEST_FIXTURE_SECRET=
TEST_FIXTURE_EMAIL=playwright-fixture@test.swarnimbagre.com
